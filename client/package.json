{
  "name": "concord",
  "productName": "Concord",
  "private": true,
  "version": "1.0.28",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "electron:dev": "cross-env ELECTRON=true vite",
    "electron:build": "tsc -p tsconfig.electron.json && cross-env ELECTRON=true vite build && electron-builder",
    "electron:start": "pnpm run electron:build && start release\\win-unpacked\\Concord.exe",
    "preview": "vite preview"
  },
  "dependencies": {
    "@giphy/js-fetch-api": "^5.8.0",
    "@giphy/react-components": "^10.1.2",
    "@supabase/supabase-js": "^2.112.4",
    "electron-updater": "^6.8.9",
    "emoji-picker-react": "^4.19.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-draggable": "^4.7.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.concord.desktop",
    "icon": "build/icon.png",
    "win": {
      "artifactName": "Concord-Setup.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nathatargino",
        "repo": "Concord-Repo"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ]
  }
}
