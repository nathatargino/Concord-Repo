{
  "name": "client",
  "productName": "Concord",
  "description": "Concord Desktop",
  "author": {
    "name": "Nathã S Targino",
    "email": "nathatargino@users.noreply.github.com"
  },
  "private": true,
  "version": "1.0.101",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "electron:dev": "cross-env ELECTRON=true vite",
    "electron:build": "tsc -p tsconfig.electron.json && cross-env ELECTRON=true vite build && electron-builder",
    "electron:ci": "tsc -p tsconfig.electron.json && cross-env ELECTRON=true vite build && electron-builder --publish never",
    "electron:start": "pnpm run electron:build && start release\\win-unpacked\\Concord.exe",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@giphy/js-fetch-api": "^5.8.0",
    "@giphy/react-components": "^10.1.2",
    "@supabase/supabase-js": "^2.112.4",
    "electron-updater": "^6.8.9",
    "emoji-picker-react": "^4.19.1",
    "plyr": "^3.8.4",
    "plyr-react": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-draggable": "^4.7.1",
    "react-hot-toast": "^2.6.0",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "electron": "https://github.com/castlabs/electron-releases#v43.5.0+wvcus",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.concord.desktop",
    "icon": "build/icon.png",
    "electronDownload": {
      "unsafelyDisableChecksums": true,
      "mirrorOptions": {
        "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
      }
    },
    "afterPack": "./build/afterPack.cjs",
    "afterSign": "./build/afterPack.cjs",
    "protocols": [
      {
        "name": "Concord",
        "schemes": [
          "concord"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "appx"
      ]
    },
    "nsis": {
      "artifactName": "Concord-Setup.exe",
      "include": "build/installer.nsh",
      "shortcutName": "Concord",
      "uninstallDisplayName": "Concord"
    },
    "appx": {
      "artifactName": "Concord-Store.msix",
      "identityName": "NathSTargino.Concord-VoiceChat",
      "publisher": "CN=23A8D0D4-5602-4BD4-B2DB-B1D23E5F8436",
      "publisherDisplayName": "Nathã S Targino",
      "displayName": "Concord - Voice &amp; Chat",
      "applicationId": "App",
      "backgroundColor": "#1e1f22",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.22621.0"
    },
    "extraResources": [
      {
        "from": "build/WidevineCdm",
        "to": "WidevineCdm",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nathatargino",
        "repo": "Concord-Repo"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ]
  }
}